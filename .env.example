# ══════════════════════════════════════════════════════════════
#  Copy to `.env` and fill in. `.env` is gitignored — never commit it.
#  Plain text only (do NOT edit in TextEdit rich-text mode).
# ══════════════════════════════════════════════════════════════

# ─── Hostinger API token (hPanel → Account → API) ───
# Manages VPS / domains / DNS / billing. Does NOT upload files to shared
# hosting — the SSH block below is what actually deploys the site.
HOSTINGER_API_TOKEN=

# ─── Deploy over SSH ───
# hPanel → Websites → <site> → Advanced → SSH Access
HOSTINGER_SSH_HOST=
HOSTINGER_SSH_PORT=65002
HOSTINGER_SSH_USER=
# Path to a deploy private key. Preferred — no password in this file.
HOSTINGER_SSH_KEY=
HOSTINGER_SSH_PASS=
HOSTINGER_REMOTE_PATH=/home/uXXXXXXXXX/domains/forestaindia.com/public_html

# ─── Site ───
SITE_DOMAIN=https://forestaindia.com

# ─── Contact form mail (lands on the SERVER only, never in the repo) ───
# Use the SMTP of whoever hosts the domain's MAIL, which may not be the web host.
# forestaindia.com mail is on GoDaddy, so: smtpout.secureserver.net
# Sending from a server the domain's SPF doesn't authorise gets quarantined.
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
CONTACT_TO=
