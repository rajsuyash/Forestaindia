---
interface Props {
  eyebrow?: string;
  title: string;
  body?: string;
  align?: 'left' | 'center';
  /** Renders as h1 on hero-less pages that need the heading to be the page title. */
  as?: 'h1' | 'h2';
}

const { eyebrow, title, body, align = 'center', as: Tag = 'h2' } = Astro.props;
---

<div class:list={['max-w-3xl', align === 'center' ? 'mx-auto text-center' : '']} data-reveal>
  {eyebrow && <p class="eyebrow mb-3">{eyebrow}</p>}
  <Tag class="text-3xl font-semibold tracking-tight md:text-4xl">{title}</Tag>
  {body && <p class="mt-4 text-base leading-relaxed text-muted-foreground md:text-lg">{body}</p>}
</div>
