---
import { Image } from 'astro:assets';
import type { System } from '../data/systems';

interface Props {
  system: System;
  delay?: number;
}

const { system, delay = 0 } = Astro.props;
---

<a
  href={`/product#${system.id}`}
  class="group glass flex flex-col overflow-hidden rounded-[var(--radius)] transition-[border-color,transform] duration-300 hover:-translate-y-1 hover:border-primary/50"
  data-reveal
  style={`--reveal-delay:${delay}ms`}
>
  <div class="relative aspect-4/3 overflow-hidden bg-forest-deep">
    <Image
      src={system.image}
      alt={`Foresta ${system.name} unit`}
      widths={[400, 640, 900]}
      sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 90vw"
      class="h-full w-full object-contain p-6 transition-transform duration-500 group-hover:scale-105"
    />
  </div>

  <div class="flex flex-1 flex-col p-6">
    <h3 class="text-xl font-semibold">{system.name}</h3>
    <p class="mt-1.5 text-sm font-medium text-primary">{system.treeEquivalent}</p>
    <p class="mt-3 flex-1 text-sm leading-relaxed text-muted-foreground">{system.summary}</p>
    <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-medium text-accent">
      Explore {system.name}
      <svg
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        aria-hidden="true"
        class="transition-transform group-hover:translate-x-1"
      >
        <path
          d="M5 12h14m-6-6 6 6-6 6"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </span>
  </div>
</a>
