---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'insights'>;
  delay?: number;
  /** Index page shows the excerpt; the compact grid on other pages doesn't. */
  showExcerpt?: boolean;
}

const { entry, delay = 0, showExcerpt = false } = Astro.props;
const { title, category, excerpt, hero } = entry.data;
---

<article
  class="group glass flex flex-col overflow-hidden rounded-[var(--radius)] transition-[border-color,transform] duration-300 hover:-translate-y-1 hover:border-primary/50"
  data-reveal
  style={`--reveal-delay:${delay}ms`}
>
  <a href={`/insights/${entry.id}`} class="flex flex-1 flex-col">
    <div class="aspect-16/9 overflow-hidden bg-forest-deep">
      <Image
        src={hero}
        alt=""
        widths={[400, 640, 900]}
        sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 90vw"
        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
      />
    </div>

    <div class="flex flex-1 flex-col p-5">
      <span class="eyebrow">{category}</span>
      <h3 class="mt-2.5 text-base leading-snug font-semibold group-hover:text-primary">
        {title}
      </h3>
      {
        showExcerpt && (
          <p class="mt-2.5 flex-1 text-sm leading-relaxed text-muted-foreground">{excerpt}</p>
        )
      }
      <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-medium text-accent">
        Read more
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          aria-hidden="true"
          class="transition-transform group-hover:translate-x-1"
        >
          <path
            d="M5 12h14m-6-6 6 6-6 6"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </span>
    </div>
  </a>
</article>
