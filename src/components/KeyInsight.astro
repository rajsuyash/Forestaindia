---
interface Props {
  title?: string;
}
const { title = 'Key insight' } = Astro.props;
---

<aside
  class="not-prose my-8 rounded-[var(--radius)] border border-primary/25 bg-primary/[0.06] p-6"
>
  <p class="text-xs font-semibold tracking-[0.14em] text-primary uppercase">{title}</p>
  <div class="mt-2.5 text-[15px] leading-relaxed text-foreground/90">
    <slot />
  </div>
</aside>
