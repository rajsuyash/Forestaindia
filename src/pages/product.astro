---
import { Image } from 'astro:assets';

import Base from '../layouts/Base.astro';
import SectionHeading from '../components/SectionHeading.astro';
import MetricTile from '../components/MetricTile.astro';
import CompareTable from '../components/CompareTable.astro';
import CtaBand from '../components/CtaBand.astro';

import { systems } from '../data/systems';

import bioreactor from '../assets/photos/bioreactor.jpg';
import ctrxAd from '../assets/products/ctrx-advertising.png';

const specGroups = [
  { key: 'performance', label: 'Capacity & environmental performance' },
  { key: 'capabilities', label: 'Functional capabilities' },
  { key: 'biomass', label: 'Biomass output & value creation' },
  { key: 'footprint', label: 'Footprint & installation' },
] as const;
---

<Base
  title="Living Forest Systems"
  description="Three Foresta Living Forest systems for India — Liquid Tube for interiors, Liquid Tree for urban space, and the containerised CTRX for industrial scale."
>
  <!-- ── Hero ─────────────────────────────────────────────────────────── -->
  <section class="relative isolate -mt-[72px] flex min-h-[70vh] items-center overflow-hidden">
    <Image
      src={bioreactor}
      alt=""
      aria-hidden="true"
      widths={[768, 1280, 1920]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="absolute inset-0 -z-10 h-full w-full object-cover"
    />
    <div
      class="absolute inset-0 -z-10 bg-gradient-to-b from-forest-deep/92 via-forest-deep/82 to-background"
    >
    </div>

    <div class="container-page pt-28 pb-16">
      <div class="max-w-3xl">
        <p class="eyebrow">Living Forest infrastructure</p>
        <h1 class="mt-5 text-4xl font-semibold tracking-tight sm:text-5xl">
          Three Living Forest systems.
          <span class="block text-primary">One regenerative mission.</span>
        </h1>
        <p class="mt-6 text-lg leading-relaxed text-foreground/85">
          Foresta systems capture CO₂, purify air, generate oxygen and turn emissions into renewable
          biomass — delivering measurable forest-equivalent impact in compact, deployable
          infrastructure. From interiors to industrial scale.
        </p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a href="/contact" class="btn btn-primary">Request Deployment Information</a>
          <a href="#compare" class="btn btn-outline">Compare Systems</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Choose your scale ────────────────────────────────────────────── -->
  <section class="container-page py-20 md:py-24">
    <SectionHeading
      title="Choose Your Scale of Impact"
      body="Each Foresta system is engineered around the same biological core — accelerated microalgae photosynthesis — adapted to different spatial and environmental needs."
    />
  </section>

  <!-- ── System deep dives ────────────────────────────────────────────── -->
  {
    systems.map((system, index) => (
      <section
        id={system.id}
        class:list={[
          'scroll-mt-24 border-t border-border/50 py-16 md:py-24',
          index % 2 === 0 ? 'bg-forest-deep/40' : '',
        ]}
      >
        <div class="container-page">
          <div class="grid items-start gap-10 lg:grid-cols-12 lg:gap-14">
            <div class="lg:col-span-5" data-reveal>
              <div class="glass overflow-hidden rounded-[var(--radius)] bg-forest-deep/60">
                <Image
                  src={system.image}
                  alt={`Foresta ${system.name} unit`}
                  widths={[480, 720, 960]}
                  sizes="(min-width: 1024px) 40vw, 90vw"
                  class="h-full w-full object-contain p-8"
                />
              </div>
            </div>

            <div class="lg:col-span-7" data-reveal style="--reveal-delay:80ms">
              <h2 class="text-3xl font-semibold tracking-tight">{system.name}</h2>
              <p class="mt-2 text-lg text-primary">{system.strapline}</p>
              <p class="mt-1 text-sm font-medium text-accent">{system.treeEquivalent}</p>

              <p class="mt-6 leading-relaxed text-muted-foreground">
                <span class="font-medium text-foreground">Designed for: </span>
                {system.designedFor}
              </p>

              <div class="mt-6 rounded-[var(--radius)] border border-primary/25 bg-primary/[0.06] p-5">
                <p class="text-xs font-semibold tracking-[0.14em] text-primary uppercase">
                  Why it fits India
                </p>
                <p class="mt-2.5 text-sm leading-relaxed text-foreground/85">{system.indiaFit}</p>
              </div>

              <div class="mt-8 grid gap-x-8 gap-y-7 sm:grid-cols-2">
                {specGroups.map((group) => (
                  <div>
                    <h3 class="text-sm font-semibold text-foreground">{group.label}</h3>
                    <ul class="mt-3 space-y-2">
                      {system[group.key].map((item) => (
                        <li class="flex items-start gap-2 text-sm leading-relaxed text-muted-foreground">
                          <span class="mt-[7px] h-1 w-1 shrink-0 rounded-full bg-primary" />
                          {item}
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>

              <a href="/contact" class="btn btn-outline mt-8">
                Enquire about {system.name}
              </a>
            </div>
          </div>
        </div>
      </section>
    ))
  }

  <!-- ── Advertising ──────────────────────────────────────────────────── -->
  <section class="border-t border-border/50 py-16 md:py-24">
    <div class="container-page">
      <div class="grid items-center gap-10 md:grid-cols-2 md:gap-14">
        <div class="overflow-hidden rounded-[var(--radius)] bg-forest-deep/60" data-reveal>
          <Image
            src={ctrxAd}
            alt="Foresta CTRX unit configured with advertising display panels"
            widths={[480, 720, 960]}
            sizes="(min-width: 768px) 45vw, 90vw"
            class="h-full w-full object-contain p-8"
          />
        </div>

        <div data-reveal style="--reveal-delay:80ms">
          <p class="eyebrow">Dual-purpose deployment</p>
          <h2 class="mt-3 text-2xl font-semibold tracking-tight md:text-3xl">
            Advertising that cleans the air
          </h2>
          <p class="mt-4 leading-relaxed text-muted-foreground">
            Liquid Foresta can also operate as a visible advertising unit. While it captures CO₂ and
            produces oxygen, it gives cities and brands a way to communicate a commitment to cleaner
            air.
          </p>
          <p class="mt-4 leading-relaxed text-muted-foreground">
            In India this matters commercially: outdoor media revenue can offset a meaningful share
            of deployment cost, and municipal advertising concessions become a route to funding
            climate infrastructure without drawing on capital budgets.
          </p>
          <a href="/contact" class="btn btn-outline mt-7">Discuss a media-funded deployment</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Comparison ───────────────────────────────────────────────────── -->
  <section
    id="compare"
    class="scroll-mt-24 border-t border-border/50 bg-forest-deep/40 py-20 md:py-24"
  >
    <div class="container-page">
      <SectionHeading
        title="Compare Living Forest Systems"
        body="Side-by-side capabilities across all three deployment scales."
      />
      <div class="mt-12">
        <CompareTable />
      </div>
    </div>
  </section>

  <!-- ── Why cities need this ─────────────────────────────────────────── -->
  <section class="container-page py-20 md:py-24">
    <SectionHeading
      title="Why Indian Cities Need Living Forests"
      body="Forest-equivalent absorption where land, time and air quality are all under pressure at once."
    />

    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      <MetricTile
        icon="co2"
        title="CO₂ Capture Capacity"
        body="Forest-equivalent absorption in a compact footprint."
        delay={0}
      />
      <MetricTile
        icon="oxygen"
        title="Oxygen Production"
        body="Continuous oxygen generation through photosynthesis."
        delay={80}
      />
      <MetricTile
        icon="pollutant"
        title="Pollutant Reduction"
        body="Reduction of NOx, SOx, VOCs and particulate matter."
        delay={160}
      />
      <MetricTile
        icon="biomass"
        title="Biomass Production"
        body="Harvestable algae biomass for circular applications."
        delay={240}
      />
    </div>

    <div class="glass mt-10 rounded-[var(--radius)] p-8 text-center md:p-10" data-reveal>
      <p class="text-3xl font-semibold text-primary md:text-4xl">1 system = hundreds of trees</p>
      <p class="mx-auto mt-3 max-w-2xl text-sm leading-relaxed text-muted-foreground">
        A single CTRX occupies 14.4 m² and delivers roughly 24,000 m² of forest impact — the
        difference between a parking bay and a two-and-a-half hectare plantation.
      </p>
    </div>
  </section>

  <CtaBand
    heading="Ready to scope a deployment?"
    body="Send us the site, the scale and the timeline. We will come back with a system recommendation and an indicative deployment plan."
    cta="Request Deployment Information"
  />
</Base>
