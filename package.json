{
  "name": "foresta-india",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "format": "prettier --write \"**/*.{astro,ts,tsx,js,mjs,css,md,mdx,json}\"",
    "format:check": "prettier --check \"**/*.{astro,ts,tsx,js,mjs,css,md,mdx,json}\"",
    "verify": "pnpm check && pnpm build && node scripts/check.mjs",
    "deploy": "pnpm verify && bash scripts/deploy.sh",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.4",
    "@astrojs/react": "^6.0.1",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.1.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "sharp": "^0.35.3",
    "typescript": "^5.9.3"
  }
}
